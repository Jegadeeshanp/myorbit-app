# ── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Pooled connection via PgBouncer (used by Prisma at runtime)
# Get from: Neon dashboard → your project → Connection Details → toggle "Pooled connection" ON
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Direct connection (used for Prisma migrations / db push)
# Get from: Neon dashboard → your project → Connection Details → toggle "Pooled connection" OFF
DIRECT_URL="postgresql://USER:PASSWORD@ENDPOINT.neon.tech/neondb?sslmode=require"

# ── NextAuth / Auth.js ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-random-64-char-hex-string"

# Public URL of your deployed app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ── AES-256-GCM field-level encryption ───────────────────────────────────────
# Generate with: openssl rand -hex 32   (must be exactly 64 hex chars = 32 bytes)
ENCRYPTION_KEY="replace-with-a-random-64-char-hex-string"

# ── Email (for password reset) ────────────────────────────────────────────────
# Resend API key — https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# From address used for transactional emails
EMAIL_FROM="MyOrbit <noreply@yourdomain.com>"

# AI Transaction Parser
ANTHROPIC_API_KEY=your-anthropic-api-key-here
