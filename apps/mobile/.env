# Your Vercel deployment URL — no trailing slash
EXPO_PUBLIC_API_URL=https://api.myorbitlife.com

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Web client ID (used as fallback in Expo Go)
# Google Cloud Console → APIs & Services → Credentials → your Web OAuth client
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=529212236858-o9etqq93k5jpih27ibuiop98eth2obvt.apps.googleusercontent.com

# iOS client ID — create in Google Console: type "iOS", bundle ID com.jegadeeshan.myorbit
# Paste the generated client ID below (looks like: NUMBERS-HASH.apps.googleusercontent.com)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=REPLACE_WITH_IOS_CLIENT_ID

# Android client ID — create in Google Console: type "Android", package com.jegadeeshan.myorbit
# Requires SHA-1 fingerprint from: cd apps/mobile && npx expo credentials:manager
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=529212236858-4bk1d0m2n6hsesrp9nuo1u34dbf37hi1.apps.googleusercontent.com
