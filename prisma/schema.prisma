generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?  // null for OAuth-only users (Google / Apple)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authAccounts        AuthAccount[]
  accounts            Account[]
  transactions        Transaction[]
  assets              Asset[]
  liabilities         Liability[]
  budgets             Budget[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  preferences         UserPreferences?
  userCategories      UserCategory[]
  goals               Goal[]
  taskLists           TaskList[]
  tasks               Task[]
  taskInstances       TaskInstance[]
  habits              Habit[]
  pomodoroSessions    PomodoroSession[]
  countdowns          Countdown[]
  healthEntries       HealthEntry[]
  workouts            Workout[]
  foodEntries         FoodEntry[]
  foodLogs            FoodLog[]
  pushTokens            PushToken[]
  recurringTransactions RecurringTransaction[]
  investmentTxs         InvestmentTransaction[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String
  balance     String
  creditLimit String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  accountId   String?
  date        String
  category    String
  description String
  notes       String?
  amount      String
  type        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Asset {
  id             String   @id @default(cuid())
  userId         String
  name           String
  category       String
  value          String
  invested       String
  units          Float?
  accountId      String?
  investmentType String   @default("lump_sum")
  sipConfig      String?  // JSON: { frequency, startDate, endType, endAfterTimes?, endDate? }
  symbol         String?  // market ticker or MF scheme code for auto price refresh
  // isExternallyOwned is derived client-side: !accountId — no DB column to avoid migration requirement
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  investmentTxs  InvestmentTransaction[]
  assetSips      RecurringTransaction[]

  @@index([userId])
}

// ── Investment Transactions (per-asset money movements) ────────────────────
// Every capital movement into/out of an asset is recorded here.
// total_invested = SUM(amount WHERE type IN ('LUMPSUM','SIP'))
// REDEMPTION amounts are always positive — represents withdrawal size.
model InvestmentTransaction {
  id        String   @id @default(cuid())
  assetId   String
  userId    String
  type      String   // LUMPSUM | SIP | REDEMPTION
  amount    String   // encrypted — always stored as a positive number
  date      String   // YYYY-MM-DD
  note      String?
  createdAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([userId])
}

model Liability {
  id          String   @id @default(cuid())
  userId      String
  name        String
  lender      String?
  borrowed    String
  outstanding String
  monthlyEmi  String
  emisLeft    Int
  totalRepaid String
  nextDueDate        String?
  repaymentAccountId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  name      String
  budget    Int
  spent     Int      @default(0)
  category  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Dedicated password reset token model — replaces the Session table workaround.
// Used by /api/auth/forgot-password and /api/auth/reset-password.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique  // raw secure token (not prefixed)
  expiresAt DateTime
  usedAt    DateTime?         // null = not yet used
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// OAuth provider accounts (Google, Apple). Separate from Finance Account model.
model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String   // "google" | "apple"
  providerAccountId String   // unique ID issued by the provider
  email             String?
  name              String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Persisted user preferences (theme, currency, locale).
// One row per user (optional — created on first save).
model UserPreferences {
  id        String   @id @default(cuid())
  userId    String   @unique
  currency  String   @default("INR")    // ISO 4217 code
  theme     String   @default("system") // "light" | "dark" | "system"
  locale    String   @default("en-IN")
  // Financial Profile / Vitals
  age         Int?
  dependents  Int?
  termCover   Float?
  healthCover Float?
  // Health daily targets
  stepsGoal    Int?   // default 10000 steps
  sleepGoal    Float? // default 7.5 hours
  waterGoal    Int?   // default 2000 ml
  caloriesGoal Int?   // default 2000 kcal
  // Active modules — comma-separated list of module keys
  enabledModules String @default("finance,tasks,habits,goals,health,insights")
  // First-run onboarding
  onboardingDone Boolean @default(false)
  focusModule    String  @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserCategory {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   // expense | income
  icon      String?  @default("Package")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name, type])
  @@index([userId])
}

// ── Goals Module ──────────────────────────────────────────────────────────

model Goal {
  id        String   @id @default(cuid())
  userId    String
  title     String
  category  String   @default("Personal") // Finance | Health | Career | Learning | Personal | Other
  why       String?
  metric    String?
  deadline  String?  // ISO date YYYY-MM-DD
  status    String   @default("active") // active | completed | paused
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones GoalMilestone[]
  processes  GoalProcess[]

  @@index([userId])
}

model GoalMilestone {
  id          String   @id @default(cuid())
  goalId      String
  userId      String
  title       String
  horizon     String   @default("1m") // 1m | 3m | 6m
  isCompleted Boolean  @default(false)
  dueDate     String?
  createdAt   DateTime @default(now())
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model GoalProcess {
  id        String   @id @default(cuid())
  goalId    String
  userId    String
  title     String
  frequency String   @default("daily") // daily | weekly | monthly
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

// ── Tasks Module ──────────────────────────────────────────────────────────

model TaskList {
  id        String   @id @default(cuid())
  userId    String
  name      String
  emoji     String?
  color     String?  @default("#3B82F6")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  listId      String?
  title       String
  notes       String?
  status      String    @default("active") // active | completed | wont_do
  priority    String    @default("none")   // none | low | medium | high
  dueDate     String?   // YYYY-MM-DD
  dueTime     String?   // HH:MM
  tags        String    @default("[]")     // JSON array of strings
  sortOrder   Int       @default(0)
  habitId     String?
  habit       Habit?    @relation(fields: [habitId], references: [id], onDelete: SetNull)
  completedAt DateTime?
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  isRecurring Boolean   @default(false)
  recurrenceDays Json?   // int[] [0–6], Sunday=0. null = non-recurring.
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  list        TaskList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  subtasks    TaskSubtask[]
  instances   TaskInstance[]

  @@index([userId])
}

model TaskInstance {
  id          String    @id @default(cuid())
  userId      String
  taskId      String
  date        String    // YYYY-MM-DD — the day this instance belongs to
  status      String    @default("pending") // pending | completed | deleted
  isDeleted   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, date])
  @@index([userId, date])
  @@index([userId, status])
}

model TaskSubtask {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  title     String
  notes     String?
  isDone    Boolean  @default(false)
  dueDate   String?
  dueTime   String?
  tags      String   @default("[]")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Habit {
  id           String     @id @default(cuid())
  userId       String
  name         String
  color        String?    @default("#3B82F6")
  iconEmoji    String?    @default("✅")
  goalPerDay   Int        @default(1)
  isCountBased Boolean    @default(false)
  daysOfWeek   String     @default("[1,2,3,4,5,6,7]") // JSON array
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  category     String     @default("general") // health | finance | productivity | general
  timeOfDay    String?    @default("all_day") // all_day | morning | noon | evening | night | custom
  customTime   String?    // HH:MM for custom time
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs         HabitLog[]
  tasks        Task[]

  @@index([userId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  logDate   String   // YYYY-MM-DD
  value     Int      @default(1)
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, logDate])
  @@index([habitId])
}

model PomodoroSession {
  id           String    @id @default(cuid())
  userId       String
  taskId       String?
  taskTitle    String?
  mode         String    @default("pomo") // pomo | stopwatch
  startedAt    DateTime
  endedAt      DateTime?
  durationSecs Int?
  wasCompleted Boolean   @default(false)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Countdown {
  id         String   @id @default(cuid())
  userId     String
  name       String
  iconEmoji  String?  @default("🎯")
  targetDate String   // YYYY-MM-DD
  direction  String   @default("until") // until | since
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Health Module ──────────────────────────────────────────────────────────

model HealthEntry {
  id          String   @id @default(cuid())
  userId      String
  date        String   // YYYY-MM-DD
  steps       Int?
  sleepHours  Float?
  waterMl     Int?
  weightKg    Float?
  mood        Int?     // 1–5
  energyLevel Int?     // 1–10
  heartRate   Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model Workout {
  id             String   @id @default(cuid())
  userId         String
  name           String
  type           String   @default("other") // running | cycling | strength | yoga | sports | other
  durationMins   Int      @default(30)
  caloriesBurned Int?
  distanceKm     Float?
  date           String   // YYYY-MM-DD
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Food / Nutrition Logging ───────────────────────────────────────────────

model FoodLog {
  id           String   @id @default(cuid())
  userId       String
  date         String   // YYYY-MM-DD
  foodName     String
  mealType     String   @default("snack") // breakfast | lunch | dinner | snack
  servingSize  String?  // e.g. "100g", "1 cup"
  servingGrams Float?   // numeric grams for proportional calc
  calories     Float?
  protein      Float?
  carbs        Float?
  fats         Float?
  saturatedFat Float?
  sodium       Float?   // mg
  potassium    Float?   // mg
  fiber        Float?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

// ── Recurring Finance Transactions ────────────────────────────────────────
// Stores a template for each user-defined recurring transaction.
// A daily cron fires nextDate occurrences, creates a Transaction record,
// updates the linked account balance, updates budgets, then advances nextDate.
model RecurringTransaction {
  id              String   @id @default(cuid())
  userId          String
  accountId       String?  // bank account to debit/credit for expense/income or asset SIP
  assetId         String?  // set for asset SIP templates; null for regular recurring transactions
  category        String
  description     String
  notes           String?
  amount          String   // encrypted — same sign as the amount (negative for expense)
  type            String   // expense | income | SIP (for asset SIP templates)
  recurringConfig String   // JSON: RecurringConfig { frequency, startDate, endType, ... }
  nextDate        String   // YYYY-MM-DD — date of the next occurrence to create
  occurrenceCount Int      @default(0) // how many times spawned so far (for endAfterTimes check)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset           Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([nextDate])
}

// ── Push Notifications (FCM) ───────────────────────────────────────────────

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("web") // web | ios | android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Nutrition / Food Logging ───────────────────────────────────────────────

model FoodEntry {
  id             String   @id @default(cuid())
  userId         String
  date           String   // YYYY-MM-DD
  name           String   // food item name
  mealType       String   @default("snack") // breakfast | lunch | dinner | snack
  calories       Float?
  proteinG       Float?
  carbsG         Float?
  fatG           Float?
  saturatedFatG  Float?
  sodiumMg       Float?
  potassiumMg    Float?
  fiberG         Float?
  waterMl        Float?
  servingSize    String?  // e.g. "1 cup", "100g"
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}
