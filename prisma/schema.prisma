generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts            Account[]
  transactions        Transaction[]
  assets              Asset[]
  liabilities         Liability[]
  budgets             Budget[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  preferences         UserPreferences?
  userCategories      UserCategory[]
  goals               Goal[]
  taskLists           TaskList[]
  tasks               Task[]
  habits              Habit[]
  pomodoroSessions    PomodoroSession[]
  countdowns          Countdown[]
  healthEntries       HealthEntry[]
  workouts            Workout[]
  pushTokens          PushToken[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String
  balance     String
  creditLimit String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  accountId   String?
  date        String
  category    String
  description String
  notes       String?
  amount      String
  type        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Asset {
  id             String   @id @default(cuid())
  userId         String
  name           String
  category       String
  value          String
  invested       String
  units          Float?
  accountId      String?
  investmentType String   @default("lump_sum")
  sipConfig      String?  // JSON: { frequency, startDate, endType, endAfterTimes?, endDate? }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Liability {
  id          String   @id @default(cuid())
  userId      String
  name        String
  lender      String?
  borrowed    String
  outstanding String
  monthlyEmi  String
  emisLeft    Int
  totalRepaid String
  nextDueDate        String?
  repaymentAccountId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  name      String
  budget    Int
  spent     Int      @default(0)
  category  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Dedicated password reset token model — replaces the Session table workaround.
// Used by /api/auth/forgot-password and /api/auth/reset-password.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique  // raw secure token (not prefixed)
  expiresAt DateTime
  usedAt    DateTime?         // null = not yet used
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// Persisted user preferences (theme, currency, locale).
// One row per user (optional — created on first save).
model UserPreferences {
  id        String   @id @default(cuid())
  userId    String   @unique
  currency  String   @default("INR")   // ISO 4217 code
  theme     String   @default("system") // "light" | "dark" | "system"
  locale    String   @default("en-IN")
  // Financial Profile / Vitals
  age         Int?
  dependents  Int?
  termCover   Float?
  healthCover Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserCategory {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   // expense | income
  icon      String?  @default("Package")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name, type])
  @@index([userId])
}

// ── Goals Module ──────────────────────────────────────────────────────────

model Goal {
  id        String   @id @default(cuid())
  userId    String
  title     String
  category  String   @default("Personal") // Finance | Health | Career | Learning | Personal | Other
  why       String?
  metric    String?
  deadline  String?  // ISO date YYYY-MM-DD
  status    String   @default("active") // active | completed | paused
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones GoalMilestone[]
  processes  GoalProcess[]

  @@index([userId])
}

model GoalMilestone {
  id          String   @id @default(cuid())
  goalId      String
  userId      String
  title       String
  horizon     String   @default("1m") // 1m | 3m | 6m
  isCompleted Boolean  @default(false)
  dueDate     String?
  createdAt   DateTime @default(now())
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model GoalProcess {
  id        String   @id @default(cuid())
  goalId    String
  userId    String
  title     String
  frequency String   @default("daily") // daily | weekly | monthly
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

// ── Tasks Module ──────────────────────────────────────────────────────────

model TaskList {
  id        String   @id @default(cuid())
  userId    String
  name      String
  emoji     String?
  color     String?  @default("#3B82F6")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  listId      String?
  title       String
  notes       String?
  status      String    @default("active") // active | completed | wont_do
  priority    String    @default("none")   // none | low | medium | high
  dueDate     String?   // YYYY-MM-DD
  dueTime     String?   // HH:MM
  tags        String    @default("[]")     // JSON array of strings
  sortOrder   Int       @default(0)
  completedAt DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  list        TaskList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  subtasks    TaskSubtask[]

  @@index([userId])
}

model TaskSubtask {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  title     String
  notes     String?
  isDone    Boolean  @default(false)
  dueDate   String?
  dueTime   String?
  tags      String   @default("[]")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Habit {
  id           String     @id @default(cuid())
  userId       String
  name         String
  color        String?    @default("#3B82F6")
  iconEmoji    String?    @default("✅")
  goalPerDay   Int        @default(1)
  isCountBased Boolean    @default(false)
  daysOfWeek   String     @default("[1,2,3,4,5,6,7]") // JSON array
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  timeOfDay    String?    @default("all_day") // all_day | morning | noon | evening | night | custom
  customTime   String?    // HH:MM for custom time
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs         HabitLog[]

  @@index([userId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  logDate   String   // YYYY-MM-DD
  value     Int      @default(1)
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, logDate])
  @@index([habitId])
}

model PomodoroSession {
  id           String    @id @default(cuid())
  userId       String
  taskId       String?
  taskTitle    String?
  mode         String    @default("pomo") // pomo | stopwatch
  startedAt    DateTime
  endedAt      DateTime?
  durationSecs Int?
  wasCompleted Boolean   @default(false)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Countdown {
  id         String   @id @default(cuid())
  userId     String
  name       String
  iconEmoji  String?  @default("🎯")
  targetDate String   // YYYY-MM-DD
  direction  String   @default("until") // until | since
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Health Module ──────────────────────────────────────────────────────────

model HealthEntry {
  id          String   @id @default(cuid())
  userId      String
  date        String   // YYYY-MM-DD
  steps       Int?
  sleepHours  Float?
  waterMl     Int?
  weightKg    Float?
  mood        Int?     // 1–5
  energyLevel Int?     // 1–10
  heartRate   Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model Workout {
  id             String   @id @default(cuid())
  userId         String
  name           String
  type           String   @default("other") // running | cycling | strength | yoga | sports | other
  durationMins   Int      @default(30)
  caloriesBurned Int?
  distanceKm     Float?
  date           String   // YYYY-MM-DD
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Push Notifications (FCM) ───────────────────────────────────────────────

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("web") // web | ios | android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
